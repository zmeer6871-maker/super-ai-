# Server environment example

# Server
PORT=4000
NODE_ENV=development

# Database (Postgres)
DATABASE_URL=postgres://user:password@localhost:5432/super_ai

# OpenAI
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.2
OPENAI_MAX_TOKENS=800

# SMTP for email sending (verify/forgot)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Super AI <noreply@example.com>"

# Twilio (for SMS/OTP) - optional
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# OAuth credentials (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# Generic Payment Provider configuration (provider-agnostic)
# Leave blank if you don't have a payment provider yet.
PAYMENT_PROVIDER=
# Example provider-specific vars (provider-specific integrations should be added later)
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# Session cookie secret
SESSION_SECRET=

# Quota defaults
FREE_MESSAGES_PER_DAY=150

# Migrations
RUN_MIGRATIONS=false
